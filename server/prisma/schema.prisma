generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CareerProfile {
  id                String   @id @default(uuid())
  name              String
  professionalTitle String
  bio               String?
  location          String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
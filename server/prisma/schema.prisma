generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CareerProfile {
  id                String   @id @default(uuid())
  name              String
  professionalTitle String
  bio               String?
  location          String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  skills Skill[]
  projects Project[]
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  LIBRARY
  TOOL
  DATABASE
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Skill {
  id        String        @id @default(uuid())
  name      String
  category  SkillCategory
  level     SkillLevel
  profileId String
  profile   CareerProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, name])

  projects Project[]
}

model Project {
  id            String        @id @default(uuid())
  name          String
  description   String?
  repositoryUrl String?
  liveUrl       String?
  featured      Boolean       @default(false)
  profileId     String
  profile       CareerProfile @relation(fields: [profileId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  skills Skill[]
}